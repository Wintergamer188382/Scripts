        await message.channel.send(uwuify(text))

    # ── .urban ────────────────────────────────────────────────────────────────
    elif content.startswith(".urban"):
        word = content[6:].strip()
        if not word:
            return await message.channel.send("Usage: `.urban [word]`")
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(f"https://api.urbandictionary.com/v0/define?term={word}") as resp:
                    if resp.status != 200:
                        return await message.channel.send("Couldn't reach Urban Dictionary, try again.")
                    data = await resp.json()
            if not data.get('list'):
                return await message.channel.send(f"No results found for **{word}**.")
            entry      = data['list'][0]
            definition = entry['definition'].replace('[','').replace(']','')
            example    = entry['example'].replace('[','').replace(']','')
            if len(definition) > 900: definition = definition[:900] + '...'
            if len(example)    > 300: example    = example[:300]    + '...'
            embed = discord.Embed(
                title=f"📖 {entry['word']}",
                url=entry['permalink'],
                description=definition,
                color=discord.Color.from_rgb(220, 95, 60),
            )
            if example:
                embed.add_field(name="Example", value=f"*{example}*", inline=False)
            embed.set_footer(text=f"👍 {entry['thumbs_up']}  👎 {entry['thumbs_down']}  • by {entry['author']}")
            await message.channel.send(embed=embed)
        except Exception as e:
            await message.channel.send(f"Something went wrong: {e}")

    # ── Auto-reactions ────────────────────────────────────────────────────────
    if message.author.id == TARGET_USER_ID_1:
        count_1 += 1
        if count_1 % 3 == 0:
            await message.add_reaction(REACTION_EMOJI_1)
    elif message.author.id == TARGET_USER_ID_2:
        count_2 += 1
        if count_2 % 10 == 0:
            await message.add_reaction(REACTION_EMOJI_2)

try:
    client.run(TOKEN)
except Exception as e:
    print(f"Fatal error: {e}")
