@client.event
async def on_presence_update(before, after):
    if after.id != MONITOR_USER_ID:
        return
    channel = client.get_channel(LOG_CHANNEL_ID)
    if not channel:
        return

    # Status change
    if before.status != after.status:
        is_offline = after.status == discord.Status.offline
        emb = discord.Embed(
            title="Status Update",
            description=f"**{after.name}** is now **{str(after.status).upper()}**",
            color=discord.Color.red() if is_offline else discord.Color.green(),
        )
        emb.set_author(name=after.name, icon_url=after.display_avatar.url)
        msg = await channel.send(content=f"<@{YOUR_USER_ID}>", embed=emb)
        await msg.add_reaction('💔' if is_offline else '💗')

    # Spotify
    spotify  = discord.utils.get(after.activities,  type=discord.ActivityType.listening)
    old_spot = discord.utils.get(before.activities, type=discord.ActivityType.listening)
    if spotify and spotify != old_spot:
        track_url = f"https://open.spotify.com/track/{spotify.track_id}"
        emb = discord.Embed(
            description=f"Listening to **[{spotify.title}]({track_url})**\nby **{spotify.artist}**",
            color=discord.Color.from_rgb(30, 215, 96),
        )
        emb.set_author(name=after.name, icon_url=after.display_avatar.url)
        if spotify.album_cover_url:
            emb.set_thumbnail(url=spotify.album_cover_url)
        emb.set_footer(text=f"Album: {spotify.album} | {datetime.datetime.now().strftime('%I:%M:%S %p • %d/%m/%Y')}")
        msg = await channel.send(content=f"<@{YOUR_USER_ID}>", embed=emb)
        await msg.add_reaction('💗')

@client.event
async def on_reaction_add(reaction, user):
    if user.bot:
        return
    session = help_sessions.get(reaction.message.id)
    if not session or user.id != session["user_id"]:
        return

    page  = session["page"]
    emoji = str(reaction.emoji)

    if   emoji == '▶' and page < len(HELP_PAGES) - 1:
        page += 1
    elif emoji == '◀' and page > 0:
        page -= 1
    else:
        return

    session["page"] = page
    await reaction.message.edit(embed=build_help_embed(page))
    try:
        await reaction.remove(user)
    except discord.Forbidden:
        pass

