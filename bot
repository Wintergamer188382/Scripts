async def fetch_image_bytes(url: str) -> bytes:
    async with aiohttp.ClientSession() as session:
        async with session.get(url) as resp:
            if resp.status != 200:
                raise Exception(f"HTTP {resp.status}")
            return await resp.read()

async def fetch_gif(tag: str) -> str | None:
    """Return a random Tenor gif URL for the given search tag."""
    try:
        async with aiohttp.ClientSession() as session:
            url = f"https://g.tenor.com/v1/search?q={tag}&key=LIVDSRZULELA&limit=20&contentfilter=medium"
            async with session.get(url) as resp:
                if resp.status != 200:
                    return None
                data    = await resp.json()
                results = data.get("results", [])
                if not results:
                    return None
                return random.choice(results)["media"][0]["gif"]["url"]
    except Exception:
        return None

